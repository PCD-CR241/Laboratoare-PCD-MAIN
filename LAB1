import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ThreadLocalRandom;

class SumaPare implements Runnable {

    private final int[] tab;
    private final boolean first;
    private final String numeFir;

    public SumaPare(int[] tab, boolean first, String numeFir) {
        this.tab = tab;
        this.first = first;
        this.numeFir = numeFir;
    }

    @Override
    public void run() {
        List<Integer> numerePare = new ArrayList<>();

        if (first) {
            for (int i = 0; i < tab.length; i++) {
                if (tab[i] % 2 == 0) {
                    numerePare.add(tab[i]);
                }
            }
        } else {
            for (int i = tab.length - 1; i >= 0; i--) {
                if (tab[i] % 2 == 0) {
                    numerePare.add(tab[i]);
                }
            }
        }

        for (int i = 0; i + 1 < numerePare.size(); i += 2) {
            int primul = numerePare.get(i);
            int alDoilea = numerePare.get(i + 1);
            System.out.println(numeFir + ": " + primul + " + " + alDoilea
                    + " = " + (primul + alDoilea));
        }

        if (numerePare.size() % 2 == 1) {
            System.out.println(numeFir + ": "
                    + numerePare.get(numerePare.size() - 1)
                    + " ramane fara pereche");
        }
    }
}

public class Laborator {

    public static void main(String[] args) {
        int[] tab = new int[100];

        for (int i = 0; i < tab.length; i++) {
            tab[i] = ThreadLocalRandom.current().nextInt(1, 101);
        }

        Thread th1 = new Thread(new SumaPare(tab, true, "Th1"));
        Thread th2 = new Thread(new SumaPare(tab, false, "Th2"));

        th1.start();
        th2.start();

        try {
            th1.join();
            th2.join();
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            System.err.println("Firul principal a fost intrerupt.");
        }

        afisareLenta("Agachi Viorica, grupa CR-241\n");
    }

    private static void afisareLenta(String text) {
        for (int i = 0; i < text.length(); i++) {
            System.out.print(text.charAt(i));
            System.out.flush();

            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                System.err.println("\nAfisarea a fost intrerupta.");
                return;
            }
        }
    }
}
